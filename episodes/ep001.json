 "segments": [
  {
   "scene": "hook",
   "text": "A Big Mac is the same burger everywhere.",
   "props": {
    "title": "SAME BURGER."
   }
  },
  {
   "scene": "versus",
   "text": "So why does it cost nine dollars in Switzerland, and less than two fifty in Indonesia?",
   "props": {
    "left": "CHE",
    "right": "IDN"
   }
  },
  {
   "scene": "bars",
   "text": "Here's what one Big Mac costs in U.S. dollars, as of July 2026.",
   "props": {
    "reveal": 0
   }
  },
  {
   "scene": "bars",
   "text": "Indonesia: two thirty-eight. Taiwan: two forty-two. The Philippines: two seventy-four.",
   "props": {
    "reveal": 5,
    "highlight": [
     "IDN",
     "TWN",
     "PHL"
    ]
   }
  },
  {
   "scene": "bars",
   "text": "The United States sits in the middle, at six twenty-two. The euro area pays seven oh eight.",
   "props": {
    "reveal": 7,
    "highlight": [
     "USA",
     "EUZ"
    ]
   }
  },
  {
   "scene": "bars",
   "text": "And the most expensive: Norway at eight oh five, Uruguay at eight ninety-four, and Switzerland at nine oh four.",
   "props": {
    "reveal": 11,
    "highlight": [
     "NOR",
     "URY",
     "CHE"
    ]
   }
  },
  {
   "scene": "bignumber",
   "text": "That's almost four times the price, for the exact same burger.",
   "props": {
    "value": 3.8,
    "suffix": "x",
    "caption": "Switzerland vs Indonesia"
   }
  },
  {
   "scene": "bignumber",
   "text": "The Economist calls this the Big Mac Index. By that logic, the Indonesian rupiah is about sixty-two percent undervalued against the dollar.",
   "props": {
    "value": -62,
    "suffix": "%",
    "caption": "Indonesian rupiah vs US dollar"
   }
  },
  {
   "scene": "line",
   "text": "And in America itself? In 2000, a Big Mac cost two twenty-four. Today, six twenty-two.",
   "props": {}
  },
  {
   "scene": "outro",
   "text": "Follow for more money, mapped.",
   "props": {}
  }
